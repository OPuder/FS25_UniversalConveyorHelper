<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="113">
    <author>OligenOle</author>
    <version>1.9.83.35</version>
    <title>
        <en>Universal Conveyor Helper</en>
        <de>Universal Förderband Helper</de>
    </title>
    <description>
        <en><![CDATA[Universal conveyor helper with automatic start, extended discharge range and per-conveyor settings. Suitable conveyor belts can reach up to 25 km/h forward and in reverse. Rename conveyors, enable or disable the helper and teleport to them directly from the game settings.]]></en>
        <de><![CDATA[Universeller Förderband-Helfer mit automatischem Start, erweitertem Auswurfbereich und eigenen Einstellungen pro Förderband. Geeignete Förderbänder können vorwärts und rückwärts bis zu 25 km/h fahren. Förderbänder umbenennen, Automatik ein-/ausschalten und direkt aus den Spieleinstellungen zum Förderband teleportieren.]]></de>
    </description>
    <iconFilename>icon.dds</iconFilename>
    <multiplayer supported="true"/>
    <l10n filenamePrefix="localization/l10n"/>
    <extraSourceFiles>
        <sourceFile filename="scripts/UniversalConveyorSettingsPage.lua"/>
        <sourceFile filename="scripts/UniversalConveyorSettingsGui.lua"/>
        <sourceFile filename="scripts/UniversalConveyorSettings.lua"/>
        <sourceFile filename="scripts/UniversalConveyorRegistry.lua"/>
        <sourceFile filename="scripts/UniversalConveyorAI.lua"/>
        <sourceFile filename="scripts/UniversalConveyorOperations.lua"/>
        <sourceFile filename="scripts/UniversalConveyorHelper.lua"/>
        <sourceFile filename="scripts/ConveyorDetection.lua"/>
        <sourceFile filename="scripts/ConveyorSpeedControl.lua"/>
        <sourceFile filename="scripts/AutoDriveUnloadSupport.lua"/>
        <sourceFile filename="scripts/UniversalConveyorLoadTrigger.lua"/>
        <sourceFile filename="scripts/AutoDriveUnloadNodeDiagnostics.lua"/>
        <sourceFile filename="scripts/VehicleDetection.lua"/>
        <sourceFile filename="scripts/S710RuntimeExactFillRoot.lua"/>
    </extraSourceFiles>
    <actions>
        <action name="UCH_QUANTUM_AI_TOGGLE" category="VEHICLE" axisType="HALF" ignoreComboMask="false"/>
    </actions>
    <inputBinding>
        <actionBinding action="UCH_QUANTUM_AI_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_h" />
        </actionBinding>
    </inputBinding>
</modDesc>
